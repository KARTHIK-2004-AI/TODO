datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "./client"
}

enum Role {
  OWNER
  ADMIN
  MEMBER
}

enum InviteStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
  REJECTED
}

model User {
  id              String       @id @default(uuid())
  email           String       @unique
  password        String
  name            String
  bio             String       @default("")
  phoneNumber     String       @default("")
  avatarUrl       String       @default("") @db.VarChar(2048)
  timezone        String       @default("UTC")
  preferences     String       @default("{\"theme\":\"system\",\"notifications\":true,\"emailAlerts\":true,\"language\":\"en\"}")
  todos           Todo[]
  assignedTodos   Todo[]       @relation("TodoAssignments")
  ownedTeams      Team[]
  teamMemberships TeamMember[]
  sentInvites     TeamInvite[]
  notifications   Notification[]
  activityLogs    ActivityLog[]
  comments        TaskComment[]
  attachments     TaskAttachment[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

model Team {
  id           String        @id @default(uuid())
  name         String
  createdAt    DateTime      @default(now())
  ownerId      String
  owner        User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  description  String        @default("")
  purpose      String        @default("")
  members      TeamMember[]
  invites      TeamInvite[]
  todos        Todo[]
  activityLogs ActivityLog[]
}

model TeamMember {
  id       String   @id @default(uuid())
  teamId   String
  team     Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     Role     @default(MEMBER)
  joinedAt DateTime @default(now())

  @@unique([teamId, userId])
}

model TeamInvite {
  id              String       @id @default(uuid())
  teamId          String
  team            Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  email           String
  invitedByUserId String
  invitedByUser   User         @relation(fields: [invitedByUserId], references: [id], onDelete: Cascade)
  token           String       @unique
  status          InviteStatus @default(PENDING)
  createdAt       DateTime     @default(now())
  expiresAt       DateTime
}

model Todo {
  id               String           @id @default(uuid())
  title            String
  description      String           @default("")
  completed        Boolean          @default(false)
  userId           String
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  teamId           String?
  team             Team?            @relation(fields: [teamId], references: [id], onDelete: SetNull)
  assignedToUserId String?
  assignedToUser   User?            @relation("TodoAssignments", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  priority         TaskPriority     @default(MEDIUM)
  status           TaskStatus       @default(TODO)
  dueDate          DateTime?
  startDate        DateTime?
  estimatedHours   Int?
  completedAt      DateTime?
  comments         TaskComment[]
  attachments      TaskAttachment[]
  histories        TaskHistory[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
}

model TaskComment {
  id        String   @id @default(uuid())
  taskId    String
  task      Todo     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  message   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TaskAttachment {
  id               String   @id @default(uuid())
  taskId           String
  task             Todo     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  uploadedByUserId String
  uploader         User     @relation(fields: [uploadedByUserId], references: [id], onDelete: Cascade)
  fileName         String
  fileType         String
  fileSize         Int
  storagePath      String
  createdAt        DateTime @default(now())
}

model TaskHistory {
  id            String   @id @default(uuid())
  taskId        String
  task          Todo     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  performedBy   String
  action        String
  previousValue String?  @db.Text
  newValue      String?  @db.Text
  createdAt     DateTime @default(now())
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String
  isRead    Boolean  @default(false)
  metadata  String?
  createdAt DateTime @default(now())
}

model ActivityLog {
  id         String   @id @default(uuid())
  teamId     String?
  team       Team?    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action     String
  entityType String
  entityId   String
  metadata   Json
  createdAt  DateTime @default(now())
}
